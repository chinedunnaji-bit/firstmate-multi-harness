diff --git a/bin/fm-teardown.sh b/bin/fm-teardown.sh
index ad9e042..eded536 100755
--- a/bin/fm-teardown.sh
+++ b/bin/fm-teardown.sh
@@ -287,0 +288,15 @@ TEARDOWN_BACKLOG_SKIP_REASON=
+
+# Account leases are routing hints, not cleanup authority. Retire them only
+# after the task record has been removed successfully, and never turn a router
+# maintenance failure into permission to discard or repeat task cleanup.
+release_account_lease() {  # <task-id> [firstmate-home]
+  local task_id=$1 home=${2:-$FM_HOME}
+  [ -n "${FM_ACCOUNT_ROUTER:-}" ] || return 0
+  if [ ! -x "$FM_ACCOUNT_ROUTER" ]; then
+    echo "warning: account-router lease for $task_id was not released because the router is unavailable" >&2
+    return 0
+  fi
+  if ! "$FM_ACCOUNT_ROUTER" release --task-id "$task_id" --scope "$home" >/dev/null; then
+    echo "warning: account-router lease for $task_id could not be released; run account-router.mjs release manually" >&2
+  fi
+}
@@ -686,0 +702 @@ remote_secondmate_teardown() {
+  release_account_lease "$ID"
@@ -2538,0 +2555 @@ cleanup_firstmate_home_children() {
+    release_account_lease "$child_id" "$home"
@@ -2910,0 +2928 @@ fi
+release_account_lease "$ID"
