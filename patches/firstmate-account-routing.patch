+resolve_account_profile() {
+  case "$HARNESS" in
+    codex|claude) ;;
+    *) return 0 ;;
+  esac
+  [ -n "${FM_ACCOUNT_ROUTER:-}" ] || return 0
+  [ -x "$FM_ACCOUNT_ROUTER" ] || {
+    echo "error: account router is not executable: $FM_ACCOUNT_ROUTER" >&2
+    return 1
+  }
+  command -v jq >/dev/null 2>&1 || {
+    echo "error: jq is required to validate account-router output" >&2
+    return 1
+  }
+  if ! ACCOUNT_ROUTER_RESULT=$("$FM_ACCOUNT_ROUTER" select \
+      --provider "$HARNESS" --task-id "$ID" --scope "$FM_HOME"); then
+    echo "error: $HARNESS account selection failed; the harness was not changed" >&2
+    return 1
+  fi
+  if ! printf '%s\n' "$ACCOUNT_ROUTER_RESULT" | jq -e \
+      --arg provider "$HARNESS" --arg task "$ID" '
+        .schema == "firstmate.account-router-selection.v1" and
+        .provider == $provider and .harness == $provider and .taskId == $task and
+        (.profile | type == "string" and test("^(default|account[1-9][0-9]*)$")) and
+        (.directory | type == "string" and test("^/[^\\r\\n]*$")) and
+        (.selector == (if $provider == "codex" then "CODEX_HOME" else "CLAUDE_CONFIG_DIR" end))
+      ' >/dev/null; then
+    echo "error: account router returned an invalid or cross-provider selection" >&2
+    return 1
+  fi
+  ACCOUNT_PROFILE=$(printf '%s\n' "$ACCOUNT_ROUTER_RESULT" | jq -er '.profile') || return 1
+  ACCOUNT_PROFILE_DIR=$(printf '%s\n' "$ACCOUNT_ROUTER_RESULT" | jq -er '.directory') || return 1
+  [ -d "$ACCOUNT_PROFILE_DIR" ] || {
+    echo "error: selected $HARNESS account directory is missing: $ACCOUNT_PROFILE_DIR" >&2
+    return 1
+  }
+  case "$HARNESS" in
+    codex) CODEX_HOME=$ACCOUNT_PROFILE_DIR ;;
+    claude) CLAUDE_CONFIG_DIR=$ACCOUNT_PROFILE_DIR ;;
+  esac
+}
+
