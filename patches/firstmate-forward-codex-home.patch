diff --git a/bin/fm-spawn.sh b/bin/fm-spawn.sh
index 9158fce..f9bc768 100755
--- a/bin/fm-spawn.sh
+++ b/bin/fm-spawn.sh
@@ -2987,2 +2987,8 @@ if [ "$HARNESS" = claude ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
 fi
+# Codex uses the same daemon-created pane boundary as Claude. Forward the
+# selected Codex store explicitly so a coordinator launched under an isolated
+# CODEX_HOME does not silently fall back to ~/.codex in the worker pane.
+if [ "$HARNESS" = codex ] && [ -n "${CODEX_HOME:-}" ]; then
+  LAUNCH="CODEX_HOME=$(shell_quote "$CODEX_HOME") $LAUNCH"
+fi
 if [ "$KIND" = secondmate ]; then
diff --git a/tests/fm-spawn-dispatch-profile.test.sh b/tests/fm-spawn-dispatch-profile.test.sh
index bf9c047..ff23c9b 100755
--- a/tests/fm-spawn-dispatch-profile.test.sh
+++ b/tests/fm-spawn-dispatch-profile.test.sh
@@ -89,7 +89,7 @@ run_spawn() {
   : > "$launchlog"
-  # CLAUDE_CONFIG_DIR is forwarded onto claude launches by fm-spawn, so pin it
-  # explicitly (empty by default) instead of leaking the invoking shell's value,
-  # which would make launch assertions depend on the developer's environment.
-  # A test opts in to the set case via FM_TEST_CLAUDE_CONFIG_DIR.
+  # The profile directories are forwarded onto matching launches by fm-spawn,
+  # so pin them explicitly (empty by default) instead of leaking the invoking
+  # shell's values into launch assertions. Tests opt in through FM_TEST_*.
   CLAUDE_CONFIG_DIR="${FM_TEST_CLAUDE_CONFIG_DIR:-}" \
+    CODEX_HOME="${FM_TEST_CODEX_HOME:-}" \
     FM_FAKE_LAUNCH_LOG="$launchlog" FM_FAKE_PI_VERSION="${FM_TEST_PI_VERSION:-0.84.0}" \
@@ -777 +777,32 @@ test_non_claude_harness_ignores_config_dir() {
+test_codex_forwards_firstmate_home_when_set() {
+  local rec id out status launch
+  id=profile-codex-home-z20
+  rec=$(make_spawn_case profile-codex-home codex "$id")
+  read_case_record "$rec"
+
+  out=$(FM_TEST_CODEX_HOME="/opt/test/codex-work" \
+    run_ship_spawn "$HOME_DIR" "$WT_DIR" "$FAKEBIN_DIR" "$LAUNCH_LOG" "$id" "$PROJ_DIR")
+  status=$?
+  expect_code 0 "$status" "codex spawn with CODEX_HOME set should succeed"
+  launch=$(cat "$LAUNCH_LOG")
+  assert_contains "$launch" "CODEX_HOME='/opt/test/codex-work' env -u CURSOR_AGENT -u CURSOR_INVOKED_AS codex" \
+    "codex launch did not forward firstmate's CODEX_HOME to the crewmate pane"
+  pass "codex forwards firstmate's CODEX_HOME so the crewmate uses the same credential store"
+}
+
+test_codex_omits_home_prefix_when_unset() {
+  local rec id out status launch
+  id=profile-codex-nohome-z21
+  rec=$(make_spawn_case profile-codex-nohome codex "$id")
+  read_case_record "$rec"
+
+  out=$(run_ship_spawn "$HOME_DIR" "$WT_DIR" "$FAKEBIN_DIR" "$LAUNCH_LOG" "$id" "$PROJ_DIR")
+  status=$?
+  expect_code 0 "$status" "codex spawn without CODEX_HOME should succeed"
+  launch=$(cat "$LAUNCH_LOG")
+  assert_not_contains "$launch" "CODEX_HOME=" \
+    "codex launch must not add a home prefix when firstmate has no CODEX_HOME set"
+  pass "codex omits the home prefix when firstmate runs with the single-store default"
+}
+
 test_active_dispatch_profile_does_not_block_secondmate_launch() {
@@ -824,2 +855,4 @@ test_claude_omits_config_dir_prefix_when_unset
 test_non_claude_harness_ignores_config_dir
+test_codex_forwards_firstmate_home_when_set
+test_codex_omits_home_prefix_when_unset
 test_active_dispatch_profile_does_not_block_secondmate_launch
